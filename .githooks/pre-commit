#!/bin/sh
# Local gate. CI repeats every check on push, so this only has to stay fast.
set -e

pnpm typecheck
pnpm lint

# Resolves imports to paths, so relative escapes that no-restricted-imports
# cannot see still fail.
node scripts/check-feature-boundaries.mjs

# ~2s today; catches a broken test before the diff reaches review.
pnpm test
